# Worklog environment template — copy to .env and fill in.
# .env is gitignored (secrets never committed); this template IS committed.

# Gemini API key for the auto daily-summary feature.
# Get a free key at https://aistudio.google.com/apikey
# The SAME single key is used across dev / prod / test (no per-env key).
# GEMINI_API_KEY is also accepted as an alias.
GEMINI_KEY=your_gemini_api_key_here

# Optional: override the Gemini model (default: gemini-2.5-flash-lite).
# GEMINI_MODEL=gemini-2.5-flash-lite

# DATABASE_URL and PORT are set per-environment by the npm scripts
# (dev→7071/worklog.dev.db, prod→7070/worklog.prod.db, test→7072/worklog.test.db).
